          "editorMode": "code",
          "expr": "max(voltdb_task_queue_wait_time_seconds_max{namespace=\"$cluster\",host_name=~\"$host\"})",
          "legendFormat": "__auto",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(voltdb_task_queue_wait_time_seconds_bucket{namespace=\"$cluster\",host_name=~\"$host\",partition_id=~\"$partition\",table_name=~\"$table\"}[5m])) by (le))",
          "hide": true,
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Command execution max wait time",
      "type": "stat",
      "description": "The longest time any task sat in an execution queue before a partition's execution engine picked it up. Rising wait times mean sites are saturated and transactions are backing up; use it to catch an overloaded partition or host."
    },
