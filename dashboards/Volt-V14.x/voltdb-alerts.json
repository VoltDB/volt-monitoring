        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.0.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (alertname) ((ALERTS{namespace=~\"$cluster\",alertstate=\"firing\"} * 2) or ALERTS{namespace=~\"$cluster\",alertstate=\"pending\"})",
          "legendFormat": "{{alertname}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Alert state timeline",
