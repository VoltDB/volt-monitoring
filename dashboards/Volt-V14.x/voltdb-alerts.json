    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "When each alert was pending (yellow) or firing (red) over the selected time range - the at-a-glance history of alert activity that notification tools do not keep. Empty lanes mean the alert never triggered in this window.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 70,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "yellow",
                  "index": 0,
                  "text": "pending"
                },
                "2": {
                  "color": "red",
                  "index": 1,
                  "text": "firing"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
